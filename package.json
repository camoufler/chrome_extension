{
  "name": "Camoufler",
  "description": "Camoufler helps you safely use AI without unnecessarily sharing your personal information.",
  "private": true,
  "license": "MIT",
  "version": "0.1.6",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "predev": "node scripts/download-bundled-model.mjs",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "prebuild": "node scripts/sync-standard-prompt.mjs && node scripts/download-bundled-model.mjs",
    "download:model": "node scripts/download-bundled-model.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}